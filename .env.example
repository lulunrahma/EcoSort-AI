# EcoSort AI - Environment Configuration

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (SQLite by default, compatible with PostgreSQL)
DATABASE_URL=sqlite:///./ecosort.db

# Computer Vision & Camera
CAMERA_INDEX=0
MODEL_PATH=./models/best.pt
CONFIDENCE_THRESHOLD=0.40
IMAGE_SIZE=640
MAX_INFERENCE_FPS=15

# Tracking & Counting
TRACKER_TYPE=bytetrack
COUNTING_MODE=line_crossing
VIRTUAL_LINE_Y=0.5

# Storage
SNAPSHOT_DIR=./storage/snapshots
REPORT_DIR=./storage/reports

# Notification Alert Thresholds (within 60s window)
ALERT_WINDOW_SECONDS=60
ALERT_THRESHOLD_COUNT=5
ALERT_COOLDOWN_SECONDS=120

